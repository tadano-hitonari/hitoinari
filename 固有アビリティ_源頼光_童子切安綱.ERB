@固有アビ_1192_4(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名

IF 基礎BATTLE_STATE:キャラ番号:Lv >= 45
	アビ名 = 童子切安綱＋＋
	消費ＭＰ = 90
ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 21
	アビ名 = 童子切安綱
	消費ＭＰ = 60
ENDIF

SELECTCASE RAND:4
CASE 0
	アビ汎用文字列:実行時メッセージ１ = 「容赦しませんから！」
CASE 1
	アビ汎用文字列:実行時メッセージ１ = 「──せいッ！」
CASE 2
	アビ汎用文字列:実行時メッセージ１ = 「如何です！」
CASEELSE
	アビ汎用文字列:実行時メッセージ１ = 「いざ、御免！」
ENDSELECT

SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = %アビ名%
	CASE "アビ説明文"
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 45
			詳細文文字列受け渡し変数 = 消費ＭＰ：95
			詳細文文字列受け渡し変数 += "<br>敵ランダム4体に［100％］の自属性ダメージを4回与える。"
			詳細文文字列受け渡し変数 += "<br>即死効果を与える。"
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 21
			詳細文文字列受け渡し変数 = 消費ＭＰ：55
			詳細文文字列受け渡し変数 += "<br>敵ランダム3体に［100％］の自属性ダメージを3回与える。"
			詳細文文字列受け渡し変数 += "<br>即死効果を与える。"
		ENDIF
	CASE "アビ効果"
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 45
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_敵ランダムＸ体(4)
			アビ汎用変数:効果割合 = 100
			アビ汎用文字列:攻撃側使用能力値 = 攻撃力
			FOR LOCAL, 0, 4
				CALL アビテンプレート_ダメージ処理_自属性
			NEXT
			CALL アビ汎用変数文字列リセット
			アビ汎用変数:基礎成功確率 = 100
			CALL アビテンプレート_不利効果_即死
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 21
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_敵ランダムＸ体(3)
			アビ汎用変数:効果割合 = 100
			アビ汎用文字列:攻撃側使用能力値 = 攻撃力
			FOR LOCAL, 0, 3
				CALL アビテンプレート_ダメージ処理_自属性
			NEXT
			CALL アビ汎用変数文字列リセット
			アビ汎用変数:基礎成功確率 = 100
			CALL アビテンプレート_不利効果_即死
		ENDIF
ENDSELECT


 
